RC_API=
RC_TOKEN=

# Wie oft (in Sekunden) tatsaechlich geprueft wird - der systemd-Timer selbst laeuft minuetlich
# und liest kein .env, dieser Wert steuert also das effektive Intervall. 900 = 15 Minuten.
CHECK_INTERVAL_SECONDS=900

# Befehl, der bei einem Neustart ausgefuehrt wird - anpassbar fuer anderes Profil/Server/Account.
LAUNCH_CMD=flatpak run org.prismlauncher.PrismLauncher --launch LabyMod --server opsucht.net

# Nur noetig, wenn das Skript ueber einen systemd --user Timer laeuft: der erbt normalerweise
# NICHT die DISPLAY/DBUS-Umgebung der grafischen Sitzung, wodurch "flatpak run" (eine GUI-App)
# sonst stillschweigend fehlschlaegt. Werte aus einer laufenden Desktop-Sitzung ermitteln, z.B.:
#   for pid in $(pgrep -u "$USER"); do
#     grep -q '^DISPLAY=\|^WAYLAND_DISPLAY=' "/proc/$pid/environ" 2>/dev/null && \
#       tr '\0' '\n' < "/proc/$pid/environ" | grep -E '^(DISPLAY|WAYLAND_DISPLAY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS)=' && break
#   done
DISPLAY=
WAYLAND_DISPLAY=
XDG_RUNTIME_DIR=
DBUS_SESSION_BUS_ADDRESS=
